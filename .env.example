# Public DNS names only: no scheme, port or path. Use distinct hostnames.
PUBLIC_HOST=signup.example.com
ADMIN_HOST=admin.example.com

# Whitespace-separated trusted public IPs or CIDRs. Replace this documentation IP.
ADMIN_ALLOWED_IPS="203.0.113.10/32"

# The first administrator created by the backend when the database is empty.
CAMPUS_ADMIN_USERNAME=campus_admin
